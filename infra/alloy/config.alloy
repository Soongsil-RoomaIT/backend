// Docker Compose 컨테이너 로그를 Loki로 전송합니다.
// 라벨은 compose 서비스 이름(service)과 로그 스트림만 사용해 카디널리티를 제한합니다.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = []

  // Compose가 만든 컨테이너만 수집합니다.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = ".+"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.gateway_json.receiver]
}

// Gateway(pino) JSON 로그의 숫자 level을 라벨로 승격합니다. 토큰·본문은 원래 로그에 남기지 않습니다.
loki.process "gateway_json" {
  stage.match {
    selector = "{service=\"gateway-service\"}"

    stage.json {
      expressions = { level = "level" }
    }
    stage.template {
      source   = "level"
      template = "{{ if eq .Value \"10\" }}trace{{ else if eq .Value \"20\" }}debug{{ else if eq .Value \"30\" }}info{{ else if eq .Value \"40\" }}warn{{ else if eq .Value \"50\" }}error{{ else if eq .Value \"60\" }}fatal{{ end }}"
    }
    stage.labels {
      values = { level = "" }
    }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

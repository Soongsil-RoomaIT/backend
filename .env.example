# node node-service/scripts/setup-env.js 를 실행하면 아래 비밀값을 무작위로 채운 .env를 만듭니다.
POSTGRES_PASSWORD=change-me
DATA_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
# Cloud Server → Gateway 내부 알림(POST /internal/notifications)의 X-Internal-Key. 32자 이상 무작위 값.
INTERNAL_API_KEY=REPLACE_WITH_RANDOM_64_HEX
# Mosquitto 계정. 엣지 사용자명은 EDGE_DEVICE_ID(ACL: roomcare/{deviceId}/#), Cloud Server 사용자명은 cloud-server.
EDGE_DEVICE_ID=room-001
MQTT_EDGE_PASSWORD=change-me
MQTT_CLOUD_PASSWORD=change-me
# 로그인 기능 없음: 웹 요청은 모두 이 방 사용자로 처리합니다(알림 목록·FCM 토큰의 소유자).
ROOM_USER_ID=room-user
# nginx(80)가 제공하는 같은 출처는 자동 허용됩니다. Vite 개발 서버 같은 다른 출처만 적습니다.
CORS_ORIGINS=http://localhost:5173
FCM_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
# 공공데이터포털 기상청 단기예보 키(Cloud Server가 사용). 비워 두면 해당 규칙을 건너뜁니다.
KMA_SERVICE_KEY=
# 저장소 위치가 기본(같은 폴더에 나란히)과 다를 때만 지정합니다.
# CLOUD_SERVER_DIR=../cloud-server
# WEB_DIST_DIR=../frontend/dist
# observability 프로필(Grafana) 관리자 비밀번호
GRAFANA_ADMIN_PASSWORD=change-me

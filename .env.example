KEYCLOAK_ADMIN_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
DATA_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
# room-care-automation(client credentials) 비밀값. 내부 서비스(C 서버)에 Secret으로만 전달합니다.
AUTOMATION_CLIENT_SECRET=REPLACE_WITH_RANDOM_SECRET
# observability 프로필(Grafana) 관리자 비밀번호
GRAFANA_ADMIN_PASSWORD=change-me
FIREBASE_CREDENTIALS_PATH=
CLOUD_SERVICE_URL=http://host.docker.internal:8081
# readiness 검사 경로. C 서버의 헬스 엔드포인트가 정해지면 바꿉니다(5xx·무응답이면 DOWN).
CLOUD_HEALTH_PATH=/
NODE_ENV=production
DEV_AUTH_BYPASS=false
CORS_ORIGINS=http://localhost:5173
FCM_ENABLED=false
